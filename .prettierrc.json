{
  "overrides": [
    {
      "files": "*.js",
      "options": {
        "tabWidth": 4,
        "printWidth": 120,
        "singleQuote": true,
        "trailingComma": "es5"
      }
    },
    {
      "files": "*.css",
      "options": {
        "tabWidth": 4,
        "printWidth": 120
      }
    },
    {
      "files": "*.html",
      "options": {
        "tabWidth": 4,
        "printWidth": 120
      }
    }
  ]
}
