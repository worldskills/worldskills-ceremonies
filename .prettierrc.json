{
    "overrides": [
        {
            "files": "*.js",
            "options": {
                "tabWidth": 4,
                "printWidth": 120,
                "singleQuote": true,
                "semi": true,
                "trailingComma": "es5",
                "arrowParens": "always"
            }
        },
        {
            "files": "*.css",
            "options": {
                "tabWidth": 4,
                "printWidth": 120
            }
        },
        {
            "files": "*.html",
            "options": {
                "tabWidth": 4,
                "printWidth": 120,
                "singleAttributePerLine": false
            }
        }
    ]
}
